rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
             data.keys().size() >= 2 && data.keys().size() <= 6 &&
             data.uid == request.auth.uid &&
             data.createdAt == request.time &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
             (data.get('targetLanguages', []) is list && data.get('targetLanguages', []).size() <= 10);
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['userId', 'language', 'startedAt']) &&
             data.keys().size() >= 3 && data.keys().size() <= 6 &&
             data.userId == request.auth.uid &&
             data.language is string && data.language.size() <= 50 &&
             data.startedAt == request.time &&
             (data.get('topic', '') is string && data.get('topic', '').size() <= 200) &&
             (data.get('level', 'beginner') in ['beginner', 'intermediate', 'advanced']);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['sender', 'text', 'timestamp']) &&
             data.keys().size() >= 3 && data.keys().size() <= 6 &&
             data.sender in ['user', 'ai'] &&
             data.text is string && data.text.size() <= 5000 &&
             data.timestamp == request.time &&
             (data.get('translation', '') is string && data.get('translation', '').size() <= 5000) &&
             (data.get('correction', '') is string && data.get('correction', '').size() <= 5000);
    }

    // --- Match Blocks ---

    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'targetLanguages', 'nativeLanguage'])
      );
    }

    match /conversations/{conversationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidConversation(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'topic'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow list: if isSignedIn() && 
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        allow create: if isSignedIn() && 
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid &&
                      isValidMessage(incoming());
      }
    }
  }
}
